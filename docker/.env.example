# Copy to .env next to docker-compose.yml and adjust.

# Time zone used for "today" (lot status, task dates).
TZ=Europe/Brussels

# Fill the empty database with the sample catalog from the demo (true/false).
Seed__DemoData=false

# Sign-in with OpenID Connect. Leave Authority empty to run without sign-in (internal use).
# Redirect URI to register at your identity provider: https://<your-host>/signin-oidc
Auth__Oidc__Authority=
Auth__Oidc__ClientId=
Auth__Oidc__ClientSecret=

# Behind a reverse proxy that terminates TLS, let ASP.NET Core trust X-Forwarded-* headers.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
